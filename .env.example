# Database
MONGODB_URI=your_mongodb_uri_here

# JWT
JWT_SECRET=your_jwt_secret_here
BCRYPT_ROUNDS=10

# API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# WhatsApp Integration
# Option 1: Using WhatsApp Business API (Meta)
# You need to set up a WhatsApp Business Account and get an access token
WHATSAPP_API_URL=https://graph.instagram.com/v18.0/your-phone-number-id/messages
WHATSAPP_API_KEY=your_whatsapp_business_account_access_token

# Option 2: Using Twilio (Alternative)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# Email (if needed for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_password_here
